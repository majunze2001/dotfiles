# Ignore everything
*

# But track these specific folders
# .config/: only the files listed here; everything else (gcloud creds, API keys) stays ignored
!.config/
!.config/direnv/
!.config/direnv/direnvrc
!.config/eza/
!.config/eza/theme.yml
!.config/ghostty/
!.config/ghostty/config
!.config/kitty/
!.config/kitty/kitty.conf
!.config/kitty/current-theme.conf
!.config/nvim/
!.config/nvim/init.lua
!.config/nvim/lazy-lock.json
!.config/sioyek/
!.config/sioyek/keys_user.config
!.config/sioyek/prefs_user.config
!.ssh/
!.ssh/rc
!.local
!.local/bin
!.local/bin/yolo
!.local/bin/claude-kimi
!.claude/
!.claude/CLAUDE.md
!.claude/terms.md
!.claude/settings.json
!.claude/statusline-command.sh
!.claude/skills/
!.claude/skills/**
!.codex
!.codex/config.toml

!.dotmodules/
!.dotmodules/**
!.gitconfig
!.p10k.zsh
!.tmux.conf
!.direnvrc
!.zshrc

# Always track .gitignore itself
!.gitignore
!.gitignore_global
.DS_Store
